{
  "mcpServers": {
    "maidan": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.15.2",
        "https://maidan.world/mcp/streamable",
        "--header",
        "Authorization:${AUTH_HEADER}"
      ],
      "env": {
        "AUTH_HEADER": "Bearer REPLACE_WITH_MAIDAN_TOKEN"
      }
    }
  }
}
