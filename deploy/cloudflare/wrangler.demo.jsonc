// try.maidan.world: the public demo. A visitor starts a sandbox of their own
// (POST /sandbox) from the try page, in SQLite inside one container that the
// cron destroys once a day. The runbook is docs/Deploy.md "try.maidan.world".
// .github/workflows/deploy-demo.yml deploys each release: it builds
// demo/Dockerfile on the release's signed maidan-server:<tag> image and swaps
// in the image.
// Fleet cost/security invariants: scripts/check-wrangler-fleet-gates.sh
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maidan-demo",
  "main": "src/demo.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "try.maidan.world", "custom_domain": true }],
  "containers": [
    {
      "class_name": "MaidanDemo",
      // deploy-demo.yml replaces this with the pushed registry image.
      "image": "registry.cloudflare.com/ACCOUNT/maidan-demo:RELEASE",
      "instance_type": "basic",
      // One instance: the demo's state is the one SQLite file inside it.
      "max_instances": 1
    }
  ],
  // The try page (deploy/cloudflare/try). The Worker serves it itself
  // (src/try-page.js), so a visit to the page never wakes the container.
  "assets": { "directory": "./try", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [{ "name": "MAIDAN_DEMO", "class_name": "MaidanDemo" }]
  },
  "exports": {
    "MaidanDemo": { "type": "durable-object", "storage": "sqlite" }
  },
  // DEMO_TURNSTILE_SITE_KEY (a var, set here) and DEMO_TURNSTILE_SECRET (a
  // Worker secret) turn on the human check before a sandbox mint; the Worker
  // makes it, since the container has no internet. Neither reaches the
  // container.
  "vars": { "MAIDAN_PUBLIC_ORIGIN": "https://try.maidan.world" },
  // Keep in step with DEMO_RESET_CRON in src/demo-config.js.
  "triggers": { "crons": ["0 4 * * *"] },
  "observability": { "enabled": true }
}
