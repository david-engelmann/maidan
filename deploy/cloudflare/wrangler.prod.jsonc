// maidan.world: the newest release, on Cloudflare Containers, against Neon and
// R2. The runbook is docs/Production.md, "Hosted on Cloudflare".
//
// `image` names the release the deploy-prod workflow pins; it swaps in the
// account-registry copy of ghcr.io/david-engelmann/maidan-server:<tag>.
// Secrets (DATABASE_URL, MAIDAN_CONTENT_KEK, MAIDAN_SESSION_SECRET,
// MAIDAN_OIDC_CLIENT_SECRET, S3_*) are Worker secrets, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maidan-prod",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "maidan.world", "custom_domain": true }],
  "containers": [
    {
      "class_name": "MaidanServer",
      "image": "registry.cloudflare.com/ACCOUNT/maidan-server:RELEASE",
      "instance_type": "basic",
      // One instance until traffic needs more (src/index.js).
      "max_instances": 1
    }
  ],
  // The hosted site's policy pages (privacy, terms, support); the Worker
  // decides which requests they answer (src/edge.js, SITE_PATHS).
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [{ "name": "MAIDAN", "class_name": "MaidanServer" }]
  },
  "exports": {
    "MaidanServer": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "MAIDAN_PUBLIC_ORIGIN": "https://maidan.world",
    // Hosts OAuth client metadata documents are fetched from.
    "MAIDAN_OAUTH_CLIENT_METADATA_HOSTS": "claude.ai",
    "ARTIFACT_BACKEND": "s3",
    "S3_BUCKET": "maidan-artifacts-prod",
    "S3_REGION": "auto",
    // Sign-in through Cloudflare Access for SaaS (OIDC), whose only login is
    // a one-time code mailed to the address, so its emails are proven.
    "MAIDAN_OIDC_ENABLED": "1",
    "MAIDAN_OIDC_ISSUER": "https://dengelmann.cloudflareaccess.com/cdn-cgi/access/sso/oidc/28f4a2dad1b070083497af93776b785973964224f9dd435bac9582c4732cf982",
    "MAIDAN_OIDC_CLIENT_ID": "28f4a2dad1b070083497af93776b785973964224f9dd435bac9582c4732cf982",
    "MAIDAN_OIDC_REDIRECT_URI": "https://maidan.world/auth/oidc/callback",
    "MAIDAN_OIDC_LINK_EMAIL": "1",
    "MAIDAN_OIDC_EMAILS_VERIFIED": "1",
    // Sign-up by waitlist invite only (docs/Hosted Console.md); never
    // auto-provisioning, which boot refuses beside it.
    "MAIDAN_SIGNUP": "1",
    // The site's policy pages, linked from the waitlist page's footer.
    "MAIDAN_SIGNUP_PRIVACY_URL": "/privacy",
    "MAIDAN_SIGNUP_TERMS_URL": "/terms"
  },
  "triggers": { "crons": ["0 * * * *"] },
  "observability": { "enabled": true }
}
