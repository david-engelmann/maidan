// maidan.world: the newest release, on Cloudflare Containers, against Neon and
// R2. The runbook is docs/Hosted Operations.md.
//
// `image` names the release the deploy-prod workflow pins; it swaps in the
// account-registry copy of ghcr.io/david-engelmann/maidan-server:<tag>.
// Secrets (DATABASE_URL, MAIDAN_CONTENT_KEK, MAIDAN_SESSION_SECRET,
// MAIDAN_OIDC_CLIENT_SECRET, S3_*) are Worker secrets, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "maidan-prod",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "routes": [{ "pattern": "maidan.world", "custom_domain": true }],
  "containers": [
    {
      "class_name": "MaidanServer",
      "image": "registry.cloudflare.com/ACCOUNT/maidan-server:RELEASE",
      "instance_type": "basic",
      // One instance until traffic needs more (src/index.js).
      "max_instances": 1
    }
  ],
  // The hosted site's policy pages (privacy, terms, support); the Worker
  // decides which requests they answer (src/edge.js, SITE_PATHS).
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": {
    "bindings": [{ "name": "MAIDAN", "class_name": "MaidanServer" }]
  },
  "exports": {
    "MaidanServer": { "type": "durable-object", "storage": "sqlite" }
  },
  "vars": {
    "MAIDAN_PUBLIC_ORIGIN": "https://maidan.world",
    // Hosts OAuth client metadata documents are fetched from: Claude and
    // Claude Code (claude.ai), ChatGPT and Codex (chatgpt.com), Zed and VS
    // Code. Each of these clients uses its document whenever discovery says
    // documents are accepted, and never falls back to registering.
    "MAIDAN_OAUTH_CLIENT_METADATA_HOSTS": "claude.ai,chatgpt.com,zed.dev,vscode.dev",
    // RFC 7591 dynamic client registration, for every other MCP client
    // (Cursor, Gemini CLI, the MCP Inspector): public clients only, with
    // loopback or app-scheme redirects, plus https to VS Code's web redirect.
    "MAIDAN_OAUTH_DYNAMIC_REGISTRATION": "1",
    "MAIDAN_OAUTH_DCR_REDIRECT_HOSTS": "vscode.dev,insiders.vscode.dev",
    "ARTIFACT_BACKEND": "s3",
    "S3_BUCKET": "maidan-artifacts-prod",
    "S3_REGION": "auto",
    // Sign-in through Cloudflare Access for SaaS (OIDC), whose only login is
    // a one-time code mailed to the address, so its emails are proven.
    "MAIDAN_OIDC_ENABLED": "1",
    "MAIDAN_OIDC_ISSUER": "https://dengelmann.cloudflareaccess.com/cdn-cgi/access/sso/oidc/28f4a2dad1b070083497af93776b785973964224f9dd435bac9582c4732cf982",
    "MAIDAN_OIDC_CLIENT_ID": "28f4a2dad1b070083497af93776b785973964224f9dd435bac9582c4732cf982",
    "MAIDAN_OIDC_REDIRECT_URI": "https://maidan.world/auth/oidc/callback",
    "MAIDAN_OIDC_LINK_EMAIL": "1",
    "MAIDAN_OIDC_EMAILS_VERIFIED": "1",
    // Sign-up is open to any verified address, with the Turnstile check in
    // front (boot refuses open sign-up in production without its secret);
    // waitlist invites still work. Never auto-provisioning, which boot
    // refuses beside it (docs/Hosted Console.md).
    "MAIDAN_SIGNUP": "1",
    "MAIDAN_SIGNUP_OPEN": "1",
    // The site's policy pages, linked from the waitlist page's footer.
    "MAIDAN_SIGNUP_PRIVACY_URL": "/privacy",
    "MAIDAN_SIGNUP_TERMS_URL": "/terms",
    // The free allowance, per workspace per month: about $5 of what the
    // service costs to run (David, 2026-11-05). Past it a workspace is told;
    // an open sign-up workspace is also cut off until the month turns.
    "MAIDAN_FREE_ALLOWANCE": "requests=2000000,mcp_calls=1000000,embedding_calls=200000,deliveries=10000,wasi_ms=3600000,stored_bytes=5368709120",
    // Prepaid credits in USDC on Base (docs/Credits.md). The receiving
    // address is the maintainer's wallet; Maidan only reads transfers to it
    // and holds no key. PublicNode answers eth_getLogs over a 1,000-block
    // range with no key, where the chain's own public endpoint rate-limits.
    "MAIDAN_CREDITS_ADDRESS": "0x2eC8A54B79CD35Bbe1BB375e8C426CC6ee1a839E",
    "MAIDAN_CREDITS_CHAIN": "base",
    "MAIDAN_CREDITS_RPC_URL": "https://base-rpc.publicnode.com",
    // Past the free allowance, in micro-dollars per units: $0.50 per million
    // requests, $1 per 100,000 MCP calls, $1 per 10,000 embedding calls or
    // deliveries, and $0.01 per minute of WASI run time. Several times what
    // each costs to serve on Cloudflare Containers, Neon and R2 at this scale.
    "MAIDAN_OVERAGE_PRICES": "requests=500000/1000000,mcp_calls=1000000/100000,embedding_calls=1000000/10000,deliveries=1000000/10000,wasi_ms=10000/60000",
    // Media a workspace may hold, matching the allowance's 5 GiB.
    "MAIDAN_MEDIA_QUOTA_BYTES": "5368709120"
  },
  // Once a day, not hourly: each wake keeps the container (and Neon's
  // compute) running for the 15 minutes of sleepAfter, so an hourly cron kept
  // an idle instance billed about a quarter of every day. Schedules, retries
  // and sweeps on an idle instance wait up to a day; any request runs them.
  "triggers": { "crons": ["17 9 * * *"] },
  "observability": { "enabled": true }
}
