{
  "name": "standard-price-on-standard-tier",
  "provider": "openai-responses",
  "source": "https://platform.openai.com/docs/guides/flex-processing",
  "note": "standard_price says what a cheaper lane would have cost at standard rates; on a default-tier call there is no cheaper lane, so the server refuses it and so do the SDKs.",
  "options": {
    "standard_price": {
      "input_usd_micros_per_million": 1250000,
      "output_usd_micros_per_million": 10000000,
      "cache_read_usd_micros_per_million": 125000,
      "cache_write_5m_usd_micros_per_million": 0,
      "cache_write_1h_usd_micros_per_million": 0
    }
  },
  "response": {
    "model": "gpt-6-astra",
    "service_tier": "default",
    "usage": {
      "input_tokens": 1000,
      "input_tokens_details": {
        "cached_tokens": 0
      },
      "output_tokens": 100,
      "output_tokens_details": {
        "reasoning_tokens": 0
      },
      "total_tokens": 1100
    }
  },
  "expected_error": "standard_price is for a call in a cheaper lane"
}
