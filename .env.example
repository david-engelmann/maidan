# Maidan environment template. Copy to .env and fill in. Never commit .env.

# --- Database ---
# Postgres (prod default):
DATABASE_URL=postgres://maidan:maidan@localhost:5432/maidan
# SQLite (dev fallback):
# DATABASE_URL=sqlite://./dev.db

# --- Object storage (artifacts) ---
ARTIFACT_BACKEND=localfs
ARTIFACT_LOCALFS_ROOT=./.local/artifacts
# S3-compatible (Cluster E):
# ARTIFACT_BACKEND=s3
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=maidan-artifacts
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Server ---
MAIDAN_BIND=0.0.0.0:8080
MAIDAN_LOG=info,sqlx=warn
# Host-side published port for the compose stacks. MAIDAN_BIND is the port
# *inside* the container and does not move; this is only what the host sees,
# so set it when something else already owns 8080.
# MAIDAN_HOST_PORT=8080
# The second server in the `federation` profile.
# MAIDAN_PEER_HOST_PORT=8081

# --- Federation (outbound poll) ---
# 32-byte key as base64 or 64-char hex; encrypts peer bearer secrets at rest.
# FEDERATION_ENCRYPTION_KEY=
# FEDERATION_POLL_INTERVAL_SECS=30
# FEDERATION_DISABLED=1

# --- Event-log chain verification (Cluster 402.3) ---
# Opt-in periodic full-chain verify of every workspace that has events. Off
# unless set. This is the scheduled half of the Cluster-402.2 decision: the
# search tap verifies what it projects, and this verifies the chain itself.
# Emits maidan_chain_verify_total{outcome=ok|broken|error} and logs the
# workspace id of any broken chain. 86400 = daily.
# MAIDAN_CHAIN_VERIFY_SECS=86400

# --- Experimental Jev land-gate advisor (Cluster 408.5) ---
# Default off. This adds a separate advisory call; it never writes a land-gate
# pointer and never enters the authoritative close path. State sent to the
# advice endpoint is sent to TypeSafe. Keep off until you have a labelled
# evaluation set and have accepted the provider's data terms.
# MAIDAN_JEV_LAND_GATE_ENABLED=0
# TYPESAFE_API_KEY=
# MAIDAN_JEV_MODEL=jev-latest
# MAIDAN_JEV_GREEN_MIN_CONFIDENCE=0.90
# MAIDAN_JEV_RED_MIN_CONFIDENCE=0.90
# MAIDAN_JEV_TIMEOUT_MS=1500
# MAIDAN_JEV_BASE_URL=https://api.typesafe.ai/

# --- Observability ---
# OTLP_ENDPOINT=http://localhost:4317
# OTLP_SERVICE_NAME=maidan-server
# MAIDAN_LOG_FORMAT=json
# INDEXER_STALE_SECS=300
