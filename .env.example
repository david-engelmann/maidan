# Maidan environment template. Copy to .env and fill in. Never commit .env.

# --- Database ---
# Postgres (prod default):
DATABASE_URL=postgres://maidan:maidan@localhost:5432/maidan
# SQLite (dev fallback):
# DATABASE_URL=sqlite://./dev.db

# --- Object storage (artifacts) ---
ARTIFACT_BACKEND=localfs
ARTIFACT_LOCALFS_ROOT=./.local/artifacts
# S3-compatible (Cluster E):
# ARTIFACT_BACKEND=s3
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=maidan-artifacts
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Server ---
MAIDAN_BIND=0.0.0.0:8080
MAIDAN_LOG=info,sqlx=warn
# Host-side published port for the compose stacks. MAIDAN_BIND is the port
# *inside* the container and does not move; this is only what the host sees,
# so set it when something else already owns 8080.
# MAIDAN_HOST_PORT=8080
# The second server in the `federation` profile.
# MAIDAN_PEER_HOST_PORT=8081

# --- Federation (outbound poll) ---
# 32-byte key as base64 or 64-char hex; encrypts peer bearer secrets at rest.
# FEDERATION_ENCRYPTION_KEY=
# FEDERATION_POLL_INTERVAL_SECS=30
# FEDERATION_DISABLED=1

# --- Crypto-shredding ---
# 32-byte key-encryption key (base64 or 64-char hex) wrapping the per-message
# content keys. Required: the server refuses to start without it. Generate one
# with `openssl rand -hex 32`. Rotation: move the old key to
# MAIDAN_CONTENT_KEK_PREVIOUS.
# MAIDAN_CONTENT_KEK=
# MAIDAN_CONTENT_KEK_PREVIOUS=
# Workspace keys are wrapped by the instance KEK (`local`) unless an AWS KMS
# key holds them; the rewrap pass moves existing keys over.
# MAIDAN_WORKSPACE_KEY_CUSTODY=aws-kms
# With aws-kms, a name unique to this instance in the AWS account: keys are
# tagged with it, and KMS keys no row refers to are swept after a day.
# MAIDAN_KMS_INSTANCE=
# Local development only: use the built-in dev key, which is public, when no
# KEK is set. Refused with MAIDAN_ENV=production.
# MAIDAN_ALLOW_INSECURE_DEV_KEK=1

# --- Event-log chain verification (Cluster 402.3) ---
# Opt-in periodic full-chain verify of every workspace that has events. Off
# unless set. This is the scheduled half of the Cluster-402.2 decision: the
# search tap verifies what it projects, and this verifies the chain itself.
# Emits maidan_chain_verify_total{outcome=ok|broken|error} and logs the
# workspace id of any broken chain. 86400 = daily.
# MAIDAN_CHAIN_VERIFY_SECS=86400

# --- Advice from a decision model (TypeSafe's Jev) ---
# Default off. On, a reviewer can ask what a decision model reads in a
# hand-off: ten yes/no judgments, and green, amber or red by rules in code.
# It never writes the land gate, approves or closes. The task's title and
# description, its result and the producing agent's messages are sent to
# TypeSafe when advice is asked for (docs/Decision-Models.md).
# TYPESAFE_API_KEY is the instance's own key; leave it unset to have every
# workspace bring its own.
# MAIDAN_JEV_LAND_GATE_ENABLED=0
# TYPESAFE_API_KEY=
# MAIDAN_JEV_MODEL=jev-latest
# MAIDAN_JEV_TIMEOUT_MS=1500
# MAIDAN_JEV_BASE_URL=https://api.typesafe.ai/

# --- Observability ---
# OTLP_ENDPOINT=http://localhost:4317
# OTLP_SERVICE_NAME=maidan-server
# MAIDAN_LOG_FORMAT=json
# INDEXER_STALE_SECS=300
