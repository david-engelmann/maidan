{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Maidan Helm values",
  "type": "object",
  "required": ["podSecurityContext", "resources", "image"],
  "properties": {
    "podSecurityContext": {
      "type": "object",
      "required": ["runAsNonRoot", "runAsUser", "runAsGroup"],
      "properties": {
        "runAsNonRoot": { "type": "boolean", "const": true },
        "runAsUser": { "type": "integer", "minimum": 1 },
        "runAsGroup": { "type": "integer", "minimum": 1 },
        "fsGroup": { "type": "integer", "minimum": 1 }
      }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": {
        "requests": {
          "type": "object",
          "required": ["memory"],
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": "string", "minLength": 1 }
          }
        },
        "limits": {
          "type": "object",
          "required": ["memory"],
          "properties": {
            "cpu": { "type": ["string", "number"] },
            "memory": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" },
        "pullPolicy": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "allowAllEgress": { "type": "boolean" },
        "ingressFrom": { "type": "array" },
        "egress": { "type": "array" }
      }
    },
    "production": { "type": "boolean" },
    "replicaCount": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": true
}
