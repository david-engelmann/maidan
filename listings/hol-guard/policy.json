{
  "about": "Maidan's risk tier for every MCP tool, the input to scripts/gen-hol-guard.py. A tier says what a call can do beyond the caller's own work; guard is the HOL Guard state the tier maps to. Every tool in crates/maidan-mcp/tests/fixtures/tool-annotations.json has exactly one tier, read is exactly the read-only tools, and a write that reaches outside Maidan sits in a reviewed tier unless open_world_exceptions says why not.",
  "version": "1.0.0",
  "tiers": {
    "read": {
      "guard": "inherit",
      "means": "writes nothing"
    },
    "loop": {
      "guard": "inherit",
      "means": "the claimant's own work cycle on a thread it holds: claim, lease, usage, status, plan, footprint, evidence"
    },
    "converse": {
      "guard": "inherit",
      "means": "the caller's own messages, reactions, votes and conversations"
    },
    "personal": {
      "guard": "inherit",
      "means": "what reaches the caller: follows, mutes, read markers, notification settings"
    },
    "shape": {
      "guard": "inherit",
      "means": "ordinary, reversible changes to tasks and shared context inside the workspace"
    },
    "gate": {
      "guard": "review",
      "means": "a decision that binds others: approving a gate, a review verdict, a state transition, who must review or may land"
    },
    "remove": {
      "guard": "review",
      "means": "ends or deletes a shared record: cancelling or closing a task, withdrawing a message, deleting a term, block, recipe or schedule"
    },
    "external": {
      "guard": "review",
      "means": "sends or bridges content outside Maidan: result delivery to GitHub, Slack or Linear, message bridges"
    },
    "authority": {
      "guard": "review",
      "means": "changes who can do what or what leaves the workspace: tokens, delegation, secrets, trusted hosts, members, hooks, limits, retention, export and import"
    },
    "secret": {
      "guard": "block",
      "means": "returns a stored secret's plaintext into the caller's context; payloads name secret:// references instead"
    }
  },
  "open_world_exceptions": {
    "post_message": "open-world only because a message that starts with a registered slash command runs its handler; registering a handler is the authority tier, so a plain post stays inherit"
  },
