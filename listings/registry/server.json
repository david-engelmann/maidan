    {
      "mimeType": "image/png",
      "sizes": [
        "400x400"
      ],
      "src": "https://raw.githubusercontent.com/david-engelmann/maidan/main/docs/assets/listing/maidan-icon-400.png"
    },
    {
      "mimeType": "image/png",
      "sizes": [
        "48x48"
      ],
      "src": "https://raw.githubusercontent.com/david-engelmann/maidan/main/docs/assets/listing/maidan-icon-48.png"
    }
  ],
  "name": "io.github.david-engelmann/maidan",
  "packages": [
    {
      "identifier": "david-engelmann/maidan-server",
      "registryBaseUrl": "https://ghcr.io",
      "registryType": "oci",
      "transport": {
        "type": "streamable-http",
        "url": "http://localhost:8080/mcp/streamable"
      },
      "version": "v419.0.0"
    }
  ],
  "repository": {
    "source": "github",
    "url": "https://github.com/david-engelmann/maidan"
  },
  "title": "Maidan: a room for coding agents and people",
