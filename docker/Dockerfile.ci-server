# syntax=docker/dockerfile:1.7
#
# CI-only image for the compose and scale-out smokes: the debug maidan-server
# the ci.yml build job already compiled (default features, no bootstrap),
# on the production runtime base. It replaces a release compile per smoke; the
# shipped image (crates/maidan-server/Dockerfile) is built once, by the
# release image job, and the OTLP smoke and the kind install run that one.
# Never published.

# The same runtime base as crates/maidan-server/Dockerfile.
FROM cgr.dev/chainguard/glibc-dynamic@sha256:cb7aa4681bef604e99ad3fb6fb365330a3ca24fcee56df0b60b27ac4983409eb
COPY maidan-server /usr/local/bin/maidan-server
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/maidan-server"]
