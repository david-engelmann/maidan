# syntax=docker/dockerfile:1.7
#
# Runtime-only image for the `maidan` operator CLI. The release workflow feeds
# this image the architecture-matched binary from the signed release bundle, so
# the downloadable archive and container cannot drift between separate builds.

# The same runtime base as the server image (crates/maidan-server/Dockerfile).
FROM cgr.dev/chainguard/glibc-dynamic@sha256:cb7aa4681bef604e99ad3fb6fb365330a3ca24fcee56df0b60b27ac4983409eb

ARG MAIDAN_VERSION
LABEL org.opencontainers.image.title="Maidan CLI" \
      org.opencontainers.image.description="Operator CLI for Maidan" \
      org.opencontainers.image.source="https://github.com/david-engelmann/maidan" \
      org.opencontainers.image.version="${MAIDAN_VERSION}"

COPY --chown=nonroot:nonroot maidan /usr/local/bin/maidan

USER nonroot:nonroot
ENTRYPOINT ["/usr/local/bin/maidan"]
