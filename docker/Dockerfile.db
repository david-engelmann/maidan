# syntax=docker/dockerfile:1.7
#
# Maidan-flavored Postgres image: pgvector base only.
#
# The migration runner inside maidan-server is the single source of
# truth for schema; this image deliberately does not bundle the schema
# into docker-entrypoint-initdb.d so that fresh volumes go through the
# same code path as upgrades.

# Pinned by digest so the published maidan-postgres image does not inherit
# whatever pg16 points at on the day it is built; Dependabot moves the digest
# (.github/dependabot.yml).
FROM pgvector/pgvector:pg16@sha256:0dd3149a06e4579a0d70d8fef9945636cd514005e7237deb27f9b67886f8dc4f

# Take the base distribution's security fixes at build time. The release scan
# blocks on a fixable HIGH/CRITICAL, and the upstream image lags Debian's
# point releases (v410 shipped a pcre2 with three fixed out-of-bounds writes).
RUN apt-get update \
 && apt-get upgrade -y --no-install-recommends \
 && rm -rf /var/lib/apt/lists/*

# The WAL archive mount point (compose.pitr.yaml), owned by postgres so a fresh
# named volume mounted here inherits ownership and archive_command can write.
RUN mkdir -p /archive && chown postgres:postgres /archive
