# One-command local evaluation image (Cluster 278; default-secure since 313). Instead
# of compiling the Rust workspace, this pulls a pinned Maidan release binary and
# checks it against the release's SHA256SUMS, so a first run takes seconds.
# Development only: pair it with compose.quickstart.yaml, which runs with auth ON and
# binds to loopback — the happy path mints a bearer token with `maidan init` (bundled
# in this image). Do not use this image in production (use
# crates/maidan-server/Dockerfile, Postgres, and scoped bearer tokens).
#
# The release binaries are built on ubuntu-latest (glibc), so the runtime base is
# ubuntu:24.04 to match that glibc generation.
FROM ubuntu:24.04

# The release to install. The default in `compose.quickstart.yaml` overrides this one;
# the release record moves both, with every other deploy pin, before its tag is cut
# (scripts/release-record.sh; scripts/check-deploy-pins.sh lists them). No hash is
# pinned here: the tarball is checked against the SHA256SUMS published beside it,
# which is cosign-signed like the tarball (docs/Operations.md, "Cutting a release").
ARG MAIDAN_VERSION=v437.0.0
# Set by buildkit; fall back to the build host's arch for a plain `docker build`.
ARG TARGETARCH

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$arch" in \
      amd64) target="x86_64-unknown-linux-gnu" ;; \
      arm64) target="aarch64-unknown-linux-gnu" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/david-engelmann/maidan/releases/download/${MAIDAN_VERSION}"; \
    tarball="maidan-${target}.tar.gz"; \
    mkdir /tmp/maidan && cd /tmp/maidan; \
    echo "downloading ${base}/${tarball}"; \
    curl -fsSL "${base}/SHA256SUMS" -o SHA256SUMS; \
    curl -fsSL "${base}/${tarball}" -o "${tarball}"; \
    grep -E "^[0-9a-f]{64}  ${tarball}\$" SHA256SUMS > want \
      || { echo "${MAIDAN_VERSION}'s SHA256SUMS lists no ${tarball}" >&2; exit 1; }; \
    sha256sum -c --strict want; \
    tar -xzf "${tarball}" -C /usr/local/bin maidan-server maidan; \
    cd / && rm -rf /tmp/maidan; \
    chmod +x /usr/local/bin/maidan-server /usr/local/bin/maidan

# Non-root user; pre-create the data dir owned by it so a fresh named volume mounted
# at /data inherits that ownership (Docker seeds a new volume from the image path).
RUN useradd --system --uid 10001 --create-home maidan \
 && mkdir -p /data/artifacts \
 && chown -R maidan:maidan /data
USER maidan
WORKDIR /home/maidan

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/maidan-server"]
