# One-command local evaluation image (Cluster 278; default-secure since 313). Instead
# of compiling the Rust workspace, this pulls a pinned, SHA-256-verified Maidan release
# binary, so a first run takes seconds. Development only: pair it with
# compose.quickstart.yaml, which runs with auth ON and binds to loopback — the happy
# path mints a bearer token with `maidan init` (bundled in this image). Do not use this
# image in production (use crates/maidan-server/Dockerfile, Postgres, and scoped bearer
# tokens).
#
# The release binaries are built on ubuntu-latest (glibc), so the runtime base is
# ubuntu:24.04 to match that glibc generation.
FROM ubuntu:24.04

ARG MAIDAN_VERSION=v349.0.0
# Per-arch release tarball SHA-256 for MAIDAN_VERSION (verified at build time). Bump
# ALL THREE together when MAIDAN_VERSION changes — and the default in
# `compose.quickstart.yaml`, which overrides this one:
#   gh release download <tag> -R david-engelmann/maidan -p 'maidan-*-linux-gnu.tar.gz'
#   shasum -a 256 maidan-*-linux-gnu.tar.gz
ARG MAIDAN_SHA256_AMD64=cc94d4d4caf18e7fa66596a37d500a7d88e2d9198b2f2ead97cdfdfd00859e01
ARG MAIDAN_SHA256_ARM64=c27c7f8c6894c10901e33bd3ee93335bc7eb2b8cd7cbd306defeebd6dd45c52c
# Set by buildkit; fall back to the build host's arch for a plain `docker build`.
ARG TARGETARCH

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl \
 && rm -rf /var/lib/apt/lists/*

RUN set -eu; \
    arch="${TARGETARCH:-$(dpkg --print-architecture)}"; \
    case "$arch" in \
      amd64) target="x86_64-unknown-linux-gnu"; sha="${MAIDAN_SHA256_AMD64}" ;; \
      arm64) target="aarch64-unknown-linux-gnu"; sha="${MAIDAN_SHA256_ARM64}" ;; \
      *) echo "unsupported architecture: $arch" >&2; exit 1 ;; \
    esac; \
    url="https://github.com/david-engelmann/maidan/releases/download/${MAIDAN_VERSION}/maidan-${target}.tar.gz"; \
    echo "downloading $url"; \
    curl -fsSL "$url" -o /tmp/maidan.tar.gz; \
    echo "${sha}  /tmp/maidan.tar.gz" | sha256sum -c -; \
    tar -xzf /tmp/maidan.tar.gz -C /usr/local/bin maidan-server maidan; \
    rm /tmp/maidan.tar.gz; \
    chmod +x /usr/local/bin/maidan-server /usr/local/bin/maidan

# Non-root user; pre-create the data dir owned by it so a fresh named volume mounted
# at /data inherits that ownership (Docker seeds a new volume from the image path).
RUN useradd --system --uid 10001 --create-home maidan \
 && mkdir -p /data/artifacts \
 && chown -R maidan:maidan /data
USER maidan
WORKDIR /home/maidan

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/maidan-server"]
